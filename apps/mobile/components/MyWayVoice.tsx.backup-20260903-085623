import React, { useCallback, useEffect, useRef, useState } from "react";
import { Animated, AccessibilityInfo, AppState, Pressable, StyleSheet, Text, View } from "react-native";
import { useFocusEffect } from "expo-router";
import { Ionicons } from "@expo/vector-icons";
import { RecordingPresets, setIsAudioActiveAsync, requestRecordingPermissionsAsync, setAudioModeAsync, useAudioRecorder, useAudioRecorderState, useAudioPlayer, useAudioPlayerStatus } from "expo-audio";
import { LinearGradient } from "expo-linear-gradient";
import { deleteAsync } from "expo-file-system/legacy";

export default function MyWayVoice() {
  const recorder = useAudioRecorder(RecordingPresets.HIGH_QUALITY);
  const status = useAudioRecorderState(recorder, 150);
  const player = useAudioPlayer(null, { keepAudioSessionActive: true });
  const playback = useAudioPlayerStatus(player);
  const [uri, setUri] = useState("");
  const [busy, setBusy] = useState(false);
  const [recording, setRecording] = useState(false);
  const [message, setMessage] = useState("");
  const glow = useRef(new Animated.Value(0)).current;
  useEffect(() => {
    let animation: Animated.CompositeAnimation | undefined;
    let alive=true;
    AccessibilityInfo.isReduceMotionEnabled().then(reduce=>{
      if(!alive || reduce)return;
      animation=Animated.loop(Animated.sequence([
        Animated.timing(glow,{toValue:1,duration:2200,useNativeDriver:true}),
        Animated.timing(glow,{toValue:0,duration:2200,useNativeDriver:true}),
      ]));animation.start();
    }).catch(()=>{});
    return ()=>{alive=false;animation?.stop();};
  },[glow]);
  const live = useRef(false);
  const serial = useRef(0);
  const locked = useRef(false);
  const started = useRef(false);
  const file = useRef("");
  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);
  const clearTimer = () => { if (timer.current) clearTimeout(timer.current); timer.current=null; };
  const remove = (value: string) => { if(value) void deleteAsync(value,{idempotent:true}).catch(()=>{}); };

  const discard = useCallback(() => {
    serial.current += 1;
    clearTimer();
    try { player.pause(); } catch {}
    if(started.current) {
      started.current=false;
      locked.current=true;
      if(live.current) setBusy(true);
      void recorder.stop().catch(()=>{}).finally(()=>{
        remove(recorder.uri || "");
        void setAudioModeAsync({allowsRecording:false}).catch(()=>{}).finally(()=>{
          locked.current=false;
          if(live.current) setBusy(false);
        });
      });
    }
    remove(file.current); file.current="";
    if(live.current) {setUri("");setRecording(false);setMessage("");}
  },[recorder,player]);
  useFocusEffect(useCallback(()=>{
    live.current=true;
    return ()=>{live.current=false;discard();};
  },[discard]));
  useEffect(()=>{
    const sub=AppState.addEventListener("change",state=>{if(state==="background" || (state==="inactive" && started.current)) discard();});
    return ()=>sub.remove();
  },[discard]);

  async function stop() {
    if(locked.current || !started.current) return;
    locked.current=true; setBusy(true); clearTimer();
    const version=serial.current;
    started.current=false;
    try {
      await recorder.stop();
      await setAudioModeAsync({allowsRecording:false,playsInSilentMode:true});
      const next=recorder.uri || "";
      if(!live.current || version!==serial.current) {remove(next);return;}
      if(!next) throw new Error("Sauti haijahifadhiwa. Jaribu tena.");
      remove(file.current); file.current=next;setUri(next);
      player.replace({uri:next});
      setMessage("Rekodi ya simu tu · haijatumwa kwa AI.");
    } catch(e) {if(live.current && version===serial.current) setMessage(e instanceof Error?e.message:"Kurekodi hakujakamilika.");}
    finally {locked.current=false;if(live.current){setBusy(false);setRecording(false);}}
  }
  async function start() {
    if(locked.current || started.current) return;
    locked.current=true;setBusy(true);setMessage("");
    const version=serial.current;
    try {
      player.pause();
      const permission=await requestRecordingPermissionsAsync();
      if(!live.current || version!==serial.current) return;
      if(!permission.granted) throw new Error("Ruhusu microphone kwenye Settings za simu ili kurekodi.");
      await setIsAudioActiveAsync(true);
      await setAudioModeAsync({allowsRecording:true,playsInSilentMode:true,interruptionMode:"doNotMix",shouldPlayInBackground:false});
      await recorder.prepareToRecordAsync();
      if(!live.current || version!==serial.current) {
        await recorder.stop().catch(()=>{});remove(recorder.uri || "");
        await setAudioModeAsync({allowsRecording:false});return;
      }
      recorder.record();started.current=true;setRecording(true);
      timer.current=setTimeout(()=>{void stop();},60000);
    } catch(e) {
      await setAudioModeAsync({allowsRecording:false}).catch(()=>{});
      if(live.current && version===serial.current) { console.warn("MYWAY_MIC_START_FAILED", e); setMessage("Microphone haijaanza. Funga call au live nyingine, kisha jaribu tena. Ruhusu microphone kwenye Settings."); }
    } finally {locked.current=false;if(live.current)setBusy(false);}
  }
  async function play() {
    try {
      if(playback.playing){player.pause();return;}
      if(playback.didJustFinish || playback.currentTime>=playback.duration) await player.seekTo(0);
      player.play();
    } catch {setMessage("Sauti haijacheza. Jaribu kurekodi tena.");}
  }
  return <View style={s.box}>
    <View style={s.orbit}>
      <Animated.View pointerEvents="none" style={[s.floating,{transform:[{translateY:glow.interpolate({inputRange:[0,1],outputRange:[4,-12]})}]}]}>
        <Animated.View style={[s.glowField,{opacity:glow.interpolate({inputRange:[0,1],outputRange:[0.7,1]})}]}>
          {Array.from({length:36},(_,i)=>{
            const size=302-i*2.5;
            return <View key={i} style={{position:"absolute",width:size,height:size,borderRadius:size/2,backgroundColor:"rgba(87,207,255,0.014)"}}/>;
          })}
        </Animated.View>
        <LinearGradient colors={["#EDFCFF","#B0EFFF","#60CEFF","#2696EC"]} start={{x:0.12,y:0}} end={{x:0.9,y:1}} style={s.orb}>
          <LinearGradient colors={["#FFFFFF65","#DAF8FF20","#FFFFFF00"]} style={s.sheen}/>
          <Animated.View style={[s.shine,{opacity:glow.interpolate({inputRange:[0,1],outputRange:[0.3,0.7]}),transform:[{translateX:glow.interpolate({inputRange:[0,1],outputRange:[-45,45]})},{rotate:"-30deg"}]}]}>
            <LinearGradient colors={["#FFFFFF00","#FFFFFF55","#FFFFFF00"]} start={{x:0,y:0}} end={{x:1,y:0}} style={{flex:1}}/>
          </Animated.View>
          <View pointerEvents="none" accessible accessibilityLabel="Msalaba wenye nuru" style={s.cross}>
            <View style={s.crossVertical}/>
            <View style={s.crossHorizontal}/>
          </View>
        </LinearGradient>
      </Animated.View>
    </View>
    <View style={s.verse}>
      <Text style={s.verseText}>“Mimi ndimi nuru ya ulimwengu.”</Text>
      <Text style={s.verseReference}>YOHANA 8:12</Text>
    </View>
    {(recording || busy || playback.playing) && <Text style={s.copy}>{recording?`Inarekodi · ${Math.floor(status.durationMillis/1000)}s`:playback.playing?"Rekodi yako inacheza":"Inatayarisha…"}</Text>}
    <View style={s.controls}>
      {!!uri && !recording && <Pressable accessibilityRole="button" accessibilityLabel={playback.playing?"Sitisha sauti":"Sikiliza rekodi"} onPress={()=>void play()} disabled={busy} style={s.small}><Ionicons name={playback.playing?"pause":"play"} size={22} color="#ACDCFF"/></Pressable>}
      <Pressable accessibilityRole="button" accessibilityLabel={recording?"Simamisha kurekodi":"Anza kurekodi"} disabled={busy} onPress={()=>void(recording?stop():start())} style={[s.mic,busy&&{opacity:0.45}]}>
        <Ionicons name={recording?"stop":"mic"} size={30} color="#063676"/>
      </Pressable>
      {!!uri && !recording && <Pressable accessibilityRole="button" accessibilityLabel="Futa rekodi" disabled={busy} onPress={discard} style={s.small}><Ionicons name="trash-outline" size={22} color="#ACDCFF"/></Pressable>}
    </View>
    {!!message && <Text accessibilityRole="alert" style={s.notice}>{message}</Text>}
  </View>;
}
const s=StyleSheet.create({
 cross:{position:"absolute",left:65,top:49,width:72,height:105,shadowColor:"#FFFFFF",shadowOpacity:0.95,shadowRadius:17,shadowOffset:{width:0,height:0}},
 crossVertical:{position:"absolute",top:0,left:31,width:10,height:105,borderRadius:3,backgroundColor:"#F4FDFF"},
 crossHorizontal:{position:"absolute",top:28,left:0,width:72,height:10,borderRadius:3,backgroundColor:"#F4FDFF"},
 verse:{alignItems:"center",paddingHorizontal:12,maxWidth:330,marginBottom:4},
 verseText:{color:"#E2F6FF",fontSize:18,lineHeight:27,fontWeight:"700",textAlign:"center"},
 verseReference:{color:"#9ACCF1",fontSize:10,fontWeight:"800",letterSpacing:2,marginTop:10},
 box:{flex:1,alignItems:"center",justifyContent:"center",paddingHorizontal:20,paddingTop:16,paddingBottom:136},
 orbit:{width:310,height:330,alignItems:"center",justifyContent:"center",marginBottom:22},
 floating:{width:310,height:310,alignItems:"center",justifyContent:"center"},
 glowField:{position:"absolute",width:310,height:310,alignItems:"center",justifyContent:"center"},
 shine:{position:"absolute",top:-40,left:40,width:95,height:300},
 orb:{width:202,height:202,borderRadius:101,overflow:"hidden",borderWidth:0},
 sheen:{position:"absolute",width:180,height:140,top:-28,left:-24,borderRadius:90,transform:[{rotate:"-30deg"}]},
 title:{color:"#EFFAFF",fontSize:26,fontWeight:"900",letterSpacing:0.3,textAlign:"center"},copy:{color:"#A6D2FF",fontSize:13,fontWeight:"700",marginTop:10,textAlign:"center"},
 controls:{flexDirection:"row",gap:24,alignItems:"center",justifyContent:"center",marginTop:28},mic:{width:72,height:72,borderRadius:36,backgroundColor:"#B9EFFF",alignItems:"center",justifyContent:"center"},small:{width:48,height:48,borderRadius:24,backgroundColor:"#0C3870",alignItems:"center",justifyContent:"center"},
 notice:{color:"#AFCBE9",fontSize:12,lineHeight:18,textAlign:"center",marginTop:16,maxWidth:310},note:{color:"#729AC7",fontSize:11,textAlign:"center",marginTop:20}
});
