{
  "crons": [
    {
      "path": "/api/cron/church-voice-notes",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/refresh-video-link-stats",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
